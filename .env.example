# Copy this file to .env and fill in your values
OPENAI_API_KEY=your-openai-api-key-here

# Optional: override the model (default is gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Optional: override the maximum tokens in the AI response (default is 2048)
# OPENAI_MAX_TOKENS=2048

# Optional: override the port (default is 5000)
# PORT=5000

# Optional: enable Flask debug mode (default is false, do NOT enable in production)
# FLASK_DEBUG=false
